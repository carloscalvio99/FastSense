# =====================================================================
# FastSense · Configuración local (Docker Compose)
# Copiar a .env para ejecutar:  cp .env.example .env
# En AWS estas variables se inyectan con Secrets Manager / IRSA.
# =====================================================================

# --- Identidad y seguridad -------------------------------------------
API_KEY=fs_demo_key_2026
JWT_SECRET=fastsense_local_jwt_secret_2026_change_me
INTERNAL_TOKEN=fastsense_internal_2026
# Token HS256 de demostración (expira en 2100). Cámbielo en producción.
JWT_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJzaG9wZmFzdC1tbG9wcy1kZW1vIiwicm9sZSI6ImFkbWluIiwiaWF0IjoxNzk1MDA2OTkwLCJleHAiOjQxMDI0NDQ4MDAsImlzcyI6ImZhc3RzZW5zZS1sb2NhbCJ9.L7T0izMU3OkWpxtwNZuFMvIV5rKFoHrlzwKt9vjbR7c
PII_SALT=fastsense-pii-salt-2026
LOG_HASH_SALT=fastsense-log-salt-2026

# --- MySQL ------------------------------------------------------------
MYSQL_ROOT_PASSWORD=fastsense_root
MYSQL_DATABASE=fastsense
MYSQL_USER=fastsense
MYSQL_PASSWORD=fastsense

# --- Redis ------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- AWS / LocalStack ------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# Dejar vacío para usar AWS real (boto3 usa la cadena IAM estándar).
AWS_ENDPOINT_URL=http://localstack:4566
SQS_QUEUE_NAME=fastsense-interactions-queue
SQS_DLQ_NAME=fastsense-interactions-dlq
S3_BUCKET=fastsense-datalake-models
S3_MODEL_KEY=models/model.pkl
S3_MANIFEST_KEY=models/manifest.json
S3_LAKE_PREFIX=datalake/interactions

# --- API --------------------------------------------------------------
APP_VERSION=3.0.0
SVD_TIMEOUT_MS=400
CIRCUIT_BREAKER_FAIL_MAX=3
CIRCUIT_BREAKER_RESET_S=30
MODEL_POLL_SECONDS=10
CACHE_TTL_SECONDS=3600
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Entrenamiento ----------------------------------------------------
N_FACTORS=50
N_EPOCHS=20
TEST_SIZE=0.2
RMSE_GATE=0.85
SEED=42
TOTAL_PRODUCTS=5000
TOTAL_USERS=50000
TOTAL_INTERACTIONS=180000

# --- Frontend (Vite build args) --------------------------------------
VITE_API_BASE_URL=http://localhost:8080

# --- Compose ----------------------------------------------------------
API_REPLICAS=1
